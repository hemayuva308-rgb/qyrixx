rules_version = '2';
// Firestore security rules for QYRIXX. Publish in Firebase console > Firestore Database > Rules
// (or `firebase deploy --only firestore:rules`). Change ADMIN emails below if the team changes.
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['qyrixx2026@gmail.com'];
    }
    // Leads (enquiries, bookings, domain and publish requests). Anyone can create one through the
    // website API; only the admin can read and update them in the dashboard CRM.
    match /leads/{id} {
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.email is string && request.resource.data.email.size() < 161
        && request.resource.data.name is string && request.resource.data.name.size() < 121
        && (!('message' in request.resource.data) || request.resource.data.message.size() < 4001)
        && request.resource.data.keys().hasOnly(['type','status','createdAt','name','email','phone','company','category','service','budget','timeline','message','domain','siteId','siteName','template','date','page','uid']);
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }
    // Websites built in the template studio. Each user sees only their own; the admin sees all.
    match /sites/{id} {
      allow read, update, delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
    }
  }
}
